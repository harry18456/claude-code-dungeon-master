{
  "permissions": {
    "allow": [
      "mcp__dungeon__get_state",
      "mcp__dungeon__get_current_scene",
      "mcp__dungeon__move_to",
      "mcp__dungeon__resolve_attack",
      "mcp__dungeon__resolve_check",
      "mcp__dungeon__rest"
    ],
    "deny": [
      "Edit(CLAUDE.md)",
      "Edit(rules.md)",
      "Edit(./.claude/**)",
      "Edit(./.game/**)",
      "Edit(./engine/**)",
      "Edit(./data/**)",
      "Edit(./scenes/**)",
      "Edit(./gamectl.py)",
      "Edit(state.json)",
      "Read(./scenes/**)"
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project .claude/hooks/recap.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project .claude/hooks/story.py"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project .claude/hooks/story.py"
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project .claude/hooks/story.py",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project .claude/hooks/sound.py chimes"
          },
          {
            "type": "command",
            "command": "uv run --no-project .claude/hooks/audit.py --mode warn"
          },
          {
            "type": "command",
            "command": "uv run --no-project .claude/hooks/story.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project .claude/hooks/guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__dungeon__resolve_attack|mcp__dungeon__move_to|mcp__dungeon__resolve_check|mcp__dungeon__rest",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project .claude/hooks/sound.py --result",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "uv run --no-project .claude/statusline.py"
  },
  "outputStyle": "dm-voice"
}
